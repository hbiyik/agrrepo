# Maintainer: Mahmut Dikcizgi <boogiepop a~t gmx com>
#	https://download.acestream.media/android/media.web/stable/AceStreamMedia-3.1.80.0-armv8_64.apk
_srcname=docker-acestream-aceserve
_bin=acestreamengine
_pkgname=acestream-media
_pkgver=3.2.17-fix
pkgname=$_pkgname-bin
pkgver=3.2.17
pkgrel=2
pkgdesc='Acestream Media Service'
arch=('aarch64' 'armv7h' 'x86_64')
url='https://acestream.org'
depends=(systemd)
provides=("acestream-engine")
conflicts=("acestream-engine")
makedepends=('unzip')
options=(!strip !debug)
source=("https://github.com/jopsis/$_srcname/archive/refs/tags/v$_pkgver.tar.gz"
        $_bin
        service)
sha256sums=('fb0cbaeef11f9535887ae52ca28467fc47a6c96f21b59879059f7b802216988b'
            '1189d2cc36db180c456b9b4fafaee63c9ef2dce97b7d2e2cb4234a88fa5b3f1f'
            'c753dea4e3a1f19bc80282673ccdf0f8e8b8bce04a799e04370523fdc976e430')
install=$_pkgname.install

package() {
  _arch=$CARCH
  if [[ $CARCH == "armv7h" ]]; then
    _arch="arm32"
  fi
  if [[ $CARCH == "aarch64" ]]; then
    _arch="arm64"
  fi

  _prefix="/usr/lib/acestream"
  _statedir="/var/lib/ACEStream"
  install -d ${pkgdir}${_statedir}
  install -d ${pkgdir}${_prefix}/usr
  install -d ${pkgdir}${_prefix}/sys
  install -d ${pkgdir}${_prefix}/dev
  install -d ${pkgdir}${_prefix}/proc
  install -d ${pkgdir}${_prefix}/run

  unzip -o "${srcdir}/$_srcname-$_pkgver/aceserve-$_arch/system.zip" -d ${pkgdir}${_prefix}
  unzip -o "${srcdir}/$_srcname-$_pkgver/aceserve-$_arch/ace-*.zip" -d ${pkgdir}${_prefix}/acestream/
  chmod -R +x ${pkgdir}${_prefix}/system/bin
  chmod -R +x ${pkgdir}${_prefix}/acestream/python/bin
  cp -f ${srcdir}/$_srcname-$_pkgver/aceserve-$_arch/main.py ${pkgdir}${_prefix}/acestream/
  cp -f ${srcdir}/$_srcname-$_pkgver/aceserve-$_arch/dnsproxyd.py ${pkgdir}${_prefix}/acestream/
  cp -f ${srcdir}/$_srcname-$_pkgver/aceserve-$_arch/app_bridge.py ${pkgdir}${_prefix}/acestream/
  
  install -Dm755 ${srcdir}/$_bin ${pkgdir}/usr/bin/$_bin
  install -Dm644 "service" "$pkgdir/usr/lib/systemd/system/$_pkgname.service"
}
